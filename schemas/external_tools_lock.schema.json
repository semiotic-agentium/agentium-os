{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semiotic.ai/schemas/external_tools_lock.schema.json",
  "title": "External Tools Lockfile",
  "description": "Deployment-time contract that pins exactly which external tool artifacts an agent package is allowed to execute. Generated by the builder and embedded in the agent package.",
  "type": "object",
  "required": ["version", "tools"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Lockfile schema version.",
      "enum": ["1"]
    },
    "tools": {
      "type": "array",
      "description": "Pinned external tool entries.",
      "items": {
        "type": "object",
        "required": ["name", "digest", "abi_version", "protocol_version"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Fully qualified tool name (bundle/local_name).",
            "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_]*$"
          },
          "oci_ref": {
            "type": "string",
            "description": "OCI registry reference (without tag/digest suffix)."
          },
          "digest": {
            "type": "string",
            "description": "Content-addressed digest (e.g. sha256:abc123...).",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "platform": {
            "type": "string",
            "description": "Target platform (e.g. linux/amd64)."
          },
          "signer": {
            "type": "string",
            "description": "Identity of the artifact signer."
          },
          "abi_version": {
            "type": "string",
            "description": "Tool ABI version.",
            "enum": ["1"]
          },
          "protocol_version": {
            "type": "string",
            "description": "Tool protocol version.",
            "enum": ["1"]
          },
          "capabilities": {
            "type": "object",
            "description": "Capability subset declared at lock time for policy intersection."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
