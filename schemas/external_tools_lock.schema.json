{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karakara.dev/schemas/external_tools_lock.schema.json",
  "title": "External tools lockfile v2",
  "description": "Pins approved toolset implementations while keeping agent identity on interface digests.",
  "type": "object",
  "required": ["version", "toolsets"],
  "properties": {
    "version": { "type": "string", "const": "2" },
    "toolsets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "requirement", "tier", "tool_digest", "tools"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "requirement": { "type": "string" },
          "tier": { "enum": ["sandbox", "trusted", "service"] },
          "tool_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "descriptor_digest"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
                "descriptor_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
