{
  "targets": [
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu"
  ],
  "binaries": [
    {
      "package": "baml-agent-runner",
      "bin": "baml-agent-runner",
      "features": ["http-tools", "memory", "sandbox-provider"],
      "ship": true
    },
    {
      "package": "baml-rt-builder",
      "bin": "baml-agent-builder",
      "features": ["http-tools", "memory"],
      "ship": true
    },
    {
      "package": "cargo-agent-platform",
      "bin": "cargo-agent-platform",
      "features": [],
      "ship": true
    }
  ]
}
