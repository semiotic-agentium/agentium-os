            {
              "name": "profile",
              "in": "query",
              "description": "Payload profile: full or compact",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "format",
              "in": "query",
              "description": "Response format: full",
              "required": false,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "SSE stream of conversation history snapshots",
              "content": {
                "text/event-stream": {}
              }
            },
            "400": {
              "description": "Invalid context/query/cursor"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Conversation history service not configured"
            }
          }
        }
      },
      "/contexts/{context_id}/mermaid": {
        "get": {
          "tags": [
            "mermaid"
          ],
          "summary": "Mermaid diagram by context",
          "description": "Returns the provenance subgraph for the given A2A context ID as a Mermaid sequenceDiagram (text/plain). Available when the runner is started with SurrealDB provenance.",
          "operationId": "get_mermaid_context",
          "parameters": [
            {
              "name": "context_id",
              "in": "path",
              "description": "A2A context ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Mermaid sequenceDiagram",
              "content": {
                "text/plain": {}
              }
            },
            "404": {
              "description": "No graph found for context"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Mermaid service not available (provenance not configured)"
            }
          }
        }
      },
      "/contexts/{context_id}/metrics": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Context metrics by context_id",
          "description": "Returns turn-level and session-level token/call/duration metrics for the given A2A context ID. Available when SurrealDB-backed provenance is configured.",
          "operationId": "get_context_metrics",
          "parameters": [
            {
              "name": "context_id",
              "in": "path",
              "description": "A2A context ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Context metrics",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ContextMetricsResponseDto"
                  }
                }
              }
            },
            "404": {
              "description": "No metrics found for context"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Metrics service not available (provenance not configured)"
            }
          }
        }
      },
      "/contexts/{context_id}/observe": {
        "get": {
          "tags": [
            "provenance"
          ],
          "operationId": "get_context_observe",
          "parameters": [
            {
              "name": "context_id",
              "in": "path",
              "description": "Provenance context id",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "taskId",
              "in": "query",
              "description": "Optional task scope",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agentPackage",
              "in": "query",
              "description": "Optional agent package filter",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agentId",
              "in": "query",
              "description": "Optional agent id filter",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "include",
              "in": "query",
              "description": "Comma-separated: planning, llmOps, toolOps, drift, all",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "includeDrift",
              "in": "query",
              "description": "Include drift in planning slice",
              "required": false,
              "schema": {
                "type": "boolean"
              }
            },
            {
              "name": "opsPageSize",
              "in": "query",
              "description": "Ops page size in range [1, 50], default 20",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Unified observation bundle",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "400": {
              "description": "Invalid scope"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Observation service not configured"
            }
          }
        }
      },
