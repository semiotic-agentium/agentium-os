      "/contexts/{context_id}/conversation-history/stream": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Streaming conversation history updates by context_id",
          "description": "Event source is provenance-normalized reads, not A2A stream relays.",
          "operationId": "get_conversation_history_stream",
          "parameters": [
            {
              "name": "context_id",
              "in": "path",
              "description": "Provenance context ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "taskId",
              "in": "query",
              "description": "Optional task scope",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "limit",
              "in": "query",
              "description": "Page size in range [1, 500], default 100",
