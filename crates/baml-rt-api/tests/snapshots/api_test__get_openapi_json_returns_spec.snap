{
  "status": 200,
  "body": {
    "openapi": "3.1.0",
    "info": {
      "title": "utoipa-axum",
      "description": "Utoipa's axum bindings for seamless integration for the two",
      "contact": {
        "name": "Juha Kukkonen",
        "email": "juha7kukkonen@gmail.com"
      },
      "license": {
        "name": "MIT OR Apache-2.0",
        "identifier": "MIT OR Apache-2.0"
      },
      "version": "0.2.0"
    },
    "paths": {
      "/agents": {
        "get": {
          "tags": [
            "agents"
          ],
          "summary": "List running agents (GET /agents).",
          "operationId": "list_agents",
          "responses": {
            "200": {
              "description": "List of running agents",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/AgentDiscoveryEntryDto"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/agents/{agent_package}/{agent_instance_id}/a2a": {
        "post": {
          "tags": [
            "agents"
          ],
          "summary": "Forward A2A JSON-RPC request (POST /agents/{agent_package}/{agent_instance_id}/a2a).",
          "operationId": "post_a2a",
          "parameters": [
            {
              "name": "agent_package",
              "in": "path",
              "description": "Agent package identifier (e.g. manifest name)",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agent_instance_id",
              "in": "path",
              "description": "Agent instance identifier",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "JSON-RPC responses",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {}
                  }
                }
              }
            },
            "400": {
              "description": "Malformed request"
            },
            "404": {
              "description": "Agent not found"
            },
            "500": {
              "description": "Internal error"
            }
          }
        }
      },
      "/agents/{agent_package}/{agent_instance_id}/a2a/sse": {
        "post": {
          "tags": [
            "agents"
          ],
          "summary": "A2A over Server-Sent Events: POST /agents/{agent_package}/{agent_instance_id}/a2a/sse\nRequest body: JSON-RPC request. Response: Content-Type: text/event-stream; each event's\n`data` is one JSON-RPC response. Keep-alive comments sent on interval while stream is open.",
          "operationId": "post_a2a_sse",
          "parameters": [
            {
              "name": "agent_package",
              "in": "path",
              "description": "Agent package identifier",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agent_instance_id",
              "in": "path",
              "description": "Agent instance identifier",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "SSE stream of JSON-RPC responses",
              "content": {
                "text/event-stream": {}
              }
            },
            "400": {
              "description": "Malformed request"
            },
            "404": {
              "description": "Agent not found"
            },
            "409": {
              "description": "Conflicting concurrent stream request"
            },
            "500": {
              "description": "Internal error"
            }
          }
        }
      },
      "/agents/{agent_package}/{agent_instance_id}/dispatch": {
        "post": {
          "tags": [
            "agents"
          ],
          "summary": "Deterministic non-conversational delivery: POST /agents/{agent_package}/{agent_instance_id}/dispatch",
          "operationId": "post_dispatch",
          "parameters": [
            {
              "name": "agent_package",
              "in": "path",
              "description": "Agent package identifier",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agent_instance_id",
              "in": "path",
              "description": "Agent instance identifier",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentDispatchRequestDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Buffered delivery acknowledgement",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AgentDispatchAckDto"
                  }
                }
              }
            },
            "400": {
              "description": "Malformed request"
            },
            "404": {
              "description": "Agent or dispatch handler not found"
            },
            "500": {
              "description": "Internal error"
            }
          }
        }
      },
      "/config": {
        "get": {
          "tags": [
            "config"
          ],
          "summary": "List bundles with config schema and whether each has stored config (GET /config).",
          "operationId": "list_config",
          "responses": {
            "200": {
              "description": "List of bundles with config schema",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ToolConfigSchemaDto"
                    }
                  }
                }
              }
            },
            "503": {
              "description": "Config service not available"
            }
          }
        }
      },
      "/config/secrets-overview": {
        "get": {
          "tags": [
            "config"
          ],
          "summary": "List all required secrets with M:N consumers: tools and LLM clients (GET /config/secrets-overview).",
          "operationId": "list_secrets_overview",
          "responses": {
            "200": {
              "description": "Secrets and their tool/LLM consumers",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SecretOverviewEntryDto"
                    }
                  }
                }
              }
            },
            "503": {
              "description": "Tool catalog not available"
            }
          }
        }
      },
      "/config/secrets/store-keys": {
        "get": {
          "tags": [
            "config"
          ],
          "summary": "List keys in the secret store that have a value (for link dropdown). Returns only keys that the backend (e.g. fnox) actually resolved — not secret request names from the overview. M:N: each secret request is linked to one of these store keys.",
          "operationId": "list_store_keys",
          "responses": {
            "200": {
              "description": "Store key names that can be used as link_from",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/config/secrets/{name}": {
        "put": {
          "tags": [
            "config"
          ],
          "summary": "Link a secret by name (PUT /config/secrets/{name}).\nCopies the value of `link_from` from the secret store (fnox) into the runtime overlay for `name`. No raw values accepted.",
          "operationId": "put_secret",
          "parameters": [
            {
              "name": "name",
              "in": "path",
              "description": "Secret key to link (e.g. NOTION_API_TOKEN)",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionSecretDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "204": {
              "description": "Secret linked"
            },
            "400": {
              "description": "Invalid name or link_from has no value in store"
            },
            "501": {
              "description": "Runtime secret store not available (add keys to fnox and restart)"
            }
          }
        },
        "delete": {
          "tags": [
            "config"
          ],
          "summary": "Unlink a secret (DELETE /config/secrets/{name}).\nRemoves the key from the runtime overlay; resolution then falls back to the secret store (fnox). Returns 501 when store not available.",
          "operationId": "delete_secret",
          "parameters": [
            {
              "name": "name",
              "in": "path",
              "description": "Secret key to unlink (e.g. NOTION_API_TOKEN)",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Secret unlinked"
            },
            "400": {
              "description": "Invalid name"
            },
            "501": {
              "description": "Runtime secret store not available"
            }
          }
        }
      },
      "/config/{bundle_name}": {
        "get": {
          "tags": [
            "config"
          ],
          "summary": "Get config schema + current config for a bundle (GET /config/{bundle_name}).",
          "operationId": "get_config",
          "parameters": [
            {
              "name": "bundle_name",
              "in": "path",
              "description": "Bundle name (e.g. llm or a tool bundle that has config)",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Config schema and current config",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ToolConfigDto"
                  }
                }
              }
            },
            "404": {
              "description": "Bundle not found or has no config schema"
            },
            "503": {
              "description": "Config service not available"
            }
          }
        },
        "put": {
          "tags": [
            "config"
          ],
          "summary": "Create or update config (PUT /config/{bundle_name}).\nRequest body shape is defined by the bundle's config schema (GET /config/{bundle_name} returns it).\nSend `If-Match: <version>` to enable optimistic concurrency; returns 409 if stale.",
          "operationId": "put_config",
          "parameters": [
            {
              "name": "bundle_name",
              "in": "path",
              "description": "Bundle name (e.g. llm or a tool bundle that has config)",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "description": "Config JSON (must match bundle schema from GET /config/{bundle_name})",
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Config updated",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ConfigVersionDto"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid config"
            },
            "404": {
              "description": "Bundle not found"
            },
            "409": {
              "description": "Version conflict (stale If-Match)"
            },
            "503": {
              "description": "Config service not available"
            }
          }
        },
        "delete": {
          "tags": [
            "config"
          ],
          "summary": "Remove stored config (DELETE /config/{bundle_name}).",
          "operationId": "delete_config",
          "parameters": [
            {
              "name": "bundle_name",
              "in": "path",
              "description": "Bundle name (e.g. llm or a tool bundle that has config)",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Config removed"
            },
            "404": {
              "description": "Bundle not found"
            },
            "503": {
              "description": "Config service not available"
            }
          }
        }
      },
