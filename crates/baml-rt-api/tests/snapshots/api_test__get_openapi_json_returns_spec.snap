    "components": {
      "schemas": {
        "AgentCardDto": {
          "type": "object",
          "description": "Cut-down agent card (included in every GET /agents item).",
          "required": [
            "name",
            "version",
            "agent_package",
            "agent_instance_id",
            "tools",
            "baml_functions",
            "capabilities"
          ],
          "properties": {
            "agent_instance_id": {
              "type": "string"
            },
            "agent_package": {
              "type": "string"
            },
            "baml_functions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "BAML function names registered in the agent's runtime."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "subscriptions": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgentEventSubscriptionDto"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string"
            }
          }
        },
        "AgentDiscoveryEntryDto": {
          "type": "object",
          "description": "Discovery entry for one running agent (GET /agents response item).",
          "required": [
            "agent_package",
            "agent_instance_id",
            "name",
            "version",
            "agent_card"
          ],
          "properties": {
            "agent_card": {
              "$ref": "#/components/schemas/AgentCardDto",
              "description": "Agent card (cut-down shape) for discovery."
            },
            "agent_instance_id": {
              "type": "string"
            },
            "agent_package": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "AgentDispatchAckDto": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "AgentDispatchRequestDto": {
          "type": "object",
          "required": [
            "routing_key",
            "message_type"
          ],
          "properties": {
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_type": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metadata": {
              "type": "object"
            },
            "routing_key": {
              "type": "string"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "AgentEventSubscriptionDto": {
          "type": "object",
          "required": [
            "schema_versions",
            "source_kinds",
            "source_keys",
            "source_key_prefixes"
          ],
          "properties": {
            "schema_versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_key_prefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_kinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ConfigVersionDto": {
          "type": "object",
          "description": "Config at a specific version.",
          "required": [
            "version",
            "config",
            "created_at_ms"
          ],
          "properties": {
            "config": {
              "type": "object",
              "description": "Config snapshot. Shape defined by tool's config schema."
            },
            "created_at_ms": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "version": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ContextMetricsResponseDto": {
          "type": "object",
          "description": "API response for `GET /contexts/{context_id}/metrics`.",
          "required": [
            "context_id",
            "turns",
            "session"
          ],
          "properties": {
            "context_id": {
              "type": "string"
            },
            "session": {
              "$ref": "#/components/schemas/ContextSessionMetricsDto"
            },
            "turns": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ContextTurnMetricsDto"
              }
            }
          }
        },
        "ContextSessionMetricsDto": {
          "type": "object",
          "description": "Session-level aggregate metrics for one context id.",
          "required": [
            "turns_total",
            "user_prompts_total",
            "llm_calls_total",
            "llm_duration_ms_total",
            "tokens_total"
          ],
          "properties": {
            "llm_calls_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "llm_duration_ms_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "tokens_total": {
              "$ref": "#/components/schemas/TokenUsageDto"
            },
            "turns_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "user_prompts_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ContextTurnMetricsDto": {
          "type": "object",
          "description": "Turn-level metrics scoped by `(context_id, message_id)`.",
          "required": [
            "message_id",
            "user_prompt_count",
            "llm_call_count",
            "llm_duration_ms_total",
            "tokens"
          ],
          "properties": {
            "llm_call_count": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "llm_duration_ms_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "message_id": {
              "type": "string"
            },
            "tokens": {
              "$ref": "#/components/schemas/TokenUsageDto"
            },
            "user_prompt_count": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ProvisionSecretDto": {
          "type": "object",
          "description": "Request body for linking a secret by name (PUT /config/secrets/{name}).\nOnly link_from is accepted; secrets are stored in the secret store (fnox), never sent as raw values.",
          "required": [
            "link_from"
          ],
          "properties": {
            "link_from": {
              "type": "string",
              "description": "Key name in the secret store (fnox/env) to link from. The runner resolves this and uses its value for {name}."
            }
          }
        },
        "SecretOverviewEntryDto": {
          "type": "object",
          "description": "One secret in the M:N overview: which tools and LLM clients require it.",
          "required": [
            "name",
            "tool_consumers",
            "llm_consumers",
            "satisfied"
          ],
          "properties": {
            "descriptor": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the secret must provide (from first tool that declares it)."
            },
            "justification": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why this secret is needed (from first tool that declares it)."
            },
            "linked_to": {
              "type": [
                "string",
                "null"
              ],
              "description": "When satisfied and linked via the UI: the key in the secret store this secret is linked to (e.g. env.OPENROUTER_API_KEY). Omitted when not linked or loaded from defaults only."
            },
            "llm_consumers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "LLM client names that reference this secret (e.g. api_key placeholder for OPENROUTER_API_KEY)."
            },
            "name": {
              "type": "string",
              "description": "Canonical secret name / key (e.g. NOTION_API_TOKEN)."
            },
            "satisfied": {
              "type": "boolean",
              "description": "True if the secret is provisioned (resolver returns a value for this key); false when missing or when resolver is unavailable. Always present (not optional)."
            },
            "secret_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Type from tool secret_requests (e.g. \"api_key\"); absent if only referenced by LLM."
            },
            "tool_consumers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tool names (bundle/local) that declare this secret."
            }
          }
        },
        "SecretRequestDto": {
          "type": "object",
          "description": "Secret request (for GET /config/{tool_name}/secret-requests).",
          "required": [
            "name",
            "secret_type",
            "justification",
            "descriptor"
          ],
          "properties": {
            "descriptor": {
              "type": "string"
            },
            "justification": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "secret_type": {
              "type": "string"
            }
          }
        },
        "TokenUsageDto": {
          "type": "object",
          "description": "Token totals for a turn or session.",
          "required": [
            "in",
            "out",
            "total"
          ],
          "properties": {
            "in": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "out": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ToolConfigDto": {
          "type": "object",
          "description": "Tool config with version (GET /config/{tool_name} response).",
          "required": [
            "tool_name",
            "config",
            "version"
          ],
          "properties": {
            "config": {
              "type": "object",
              "description": "Current config (with defaults merged). Shape defined by tool's config schema."
            },
            "tool_name": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ToolConfigSchemaDto": {
          "type": "object",
          "description": "Tool config schema and default (for GET /config and GET /config/{tool_name}).",
          "required": [
            "tool_name",
            "schema",
            "has_config"
          ],
          "properties": {
            "default": {
              "type": "object",
              "description": "Default config (from schema or explicit)."
            },
            "has_config": {
              "type": "boolean",
              "description": "Whether this tool has stored config."
            },
            "schema": {
              "type": "object",
              "description": "JSON Schema for the tool's config type (defines shape of PUT /config/{tool_name} body)."
            },
            "tool_name": {
              "type": "string",
              "description": "Tool name (bundle/local)."
            }
          }
        }
      }
    },
    "tags": [
      {
        "name": "agents",
        "description": "Agent discovery, deterministic dispatch, and A2A JSON-RPC"
      },
      {
        "name": "mermaid",
        "description": "Provenance graph as Mermaid sequence diagrams (when GraphQLite is enabled)"
      },
      {
        "name": "provenance",
        "description": "Provenance-backed metrics and operational query APIs."
      },
      {
        "name": "config",
        "description": "Tool configuration and secret requests (schema includes config type schemas)"
      }
    ]
  }
}
