            "source_key": {
              "type": "string"
            },
            "source_kind": {
              "type": "string"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ProvisionSecretDto": {
          "type": "object",
          "description": "Request body for linking a secret by name (PUT /config/secrets/{name}).\nOnly link_from is accepted; secrets are stored in the secret store (fnox), never sent as raw values.",
          "required": [
            "link_from"
          ],
          "properties": {
            "link_from": {
              "type": "string",
              "description": "Key name in the secret store (fnox/env) to link from. The runner resolves this and uses its value for {name}."
            }
          }
        },
        "SecretOverviewEntryDto": {
          "type": "object",
          "description": "One secret in the M:N overview: which tools and LLM clients require it.",
          "required": [
            "name",
            "tool_consumers",
            "llm_consumers",
            "satisfied"
          ],
          "properties": {
            "descriptor": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the secret must provide (from first tool that declares it)."
            },
            "justification": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why this secret is needed (from first tool that declares it)."
            },
            "linked_to": {
              "type": [
                "string",
                "null"
              ],
              "description": "When satisfied and linked via the UI: the key in the secret store this secret is linked to (e.g. env.OPENROUTER_API_KEY). Omitted when not linked or loaded from defaults only."
            },
            "llm_consumers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "LLM client names that reference this secret (e.g. api_key placeholder for OPENROUTER_API_KEY)."
            },
            "name": {
              "type": "string",
              "description": "Canonical secret name / key (e.g. NOTION_API_TOKEN)."
            },
            "satisfied": {
              "type": "boolean",
              "description": "True if the secret is provisioned (resolver returns a value for this key); false when missing or when resolver is unavailable. Always present (not optional)."
            },
            "secret_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Type from tool secret_requests (e.g. \"api_key\"); absent if only referenced by LLM."
            },
            "tool_consumers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tool names (bundle/local) that declare this secret."
            }
          }
        },
        "SecretRequestDto": {
          "type": "object",
          "description": "Secret request (for GET /config/{tool_name}/secret-requests).",
          "required": [
            "name",
            "secret_type",
            "justification",
            "descriptor"
          ],
          "properties": {
            "descriptor": {
              "type": "string"
            },
            "justification": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "secret_type": {
              "type": "string"
            }
          }
        },
        "SessionHistoryLineDto": {
          "type": "object",
          "description": "One line of session-style history (`conversation_history` mirror).",
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "citations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ref-table strings on message-sourced rows; empty for tool/system lines."
            },
            "content": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        },
        "SessionStepOpDto": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "open"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "archive_ref",
                "header",
                "informed_by",
                "kind"
              ],
              "properties": {
                "archive_ref": {
                  "type": "string"
                },
                "header": {
                  "type": "string"
                },
                "informed_by": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "send_done"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "archive_ref",
                "grep",
                "offset",
                "limit",
                "kind"
              ],
              "properties": {
                "archive_ref": {
                  "type": "string"
                },
                "grep": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "search_read"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "archive_ref",
                "offset",
                "limit",
                "kind"
              ],
              "properties": {
                "archive_ref": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "page_read"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "StepTypeDto": {
          "type": "string",
          "description": "Episode step type for UI display.",
          "enum": [
            "message",
            "tool_call",
            "tool_read",
            "tool_result",
            "plan_revision",
            "status_transition",
            "artifact_emitted",
            "operational_event"
          ]
        },
        "TerminalStatusDto": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "completed"
              ]
            },
            {
              "type": "string",
              "enum": [
                "failed"
              ]
            },
            {
              "type": "string",
              "enum": [
                "canceled"
              ]
            },
            {
              "type": "string",
              "enum": [
                "rejected"
              ]
            },
            {
              "type": "object",
              "required": [
                "other"
              ],
              "properties": {
                "other": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "Terminal task outcome for UI display."
        },
        "TokenSummaryDto": {
          "type": "object",
          "description": "Token usage summary for UI display.",
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
            "llm_call_count",
            "llm_duration_ms"
          ],
          "properties": {
            "completion_tokens": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "llm_call_count": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "llm_duration_ms": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "prompt_tokens": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "TokenUsageDto": {
          "type": "object",
          "description": "Token totals for a turn or session.",
          "required": [
            "in",
            "out",
            "total"
          ],
          "properties": {
            "in": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "out": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ToolConfigDto": {
          "type": "object",
          "description": "Tool config with version (GET /config/{tool_name} response).",
          "required": [
            "tool_name",
            "config",
            "version"
          ],
          "properties": {
            "config": {
              "type": "object",
              "description": "Current config (with defaults merged). Shape defined by tool's config schema."
            },
            "tool_name": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ToolConfigSchemaDto": {
          "type": "object",
          "description": "Tool config schema and default (for GET /config and GET /config/{tool_name}).",
          "required": [
            "tool_name",
            "schema",
            "has_config"
          ],
          "properties": {
            "default": {
              "type": "object",
              "description": "Default config (from schema or explicit)."
            },
            "has_config": {
              "type": "boolean",
              "description": "Whether this tool has stored config."
            },
            "schema": {
              "type": "object",
              "description": "JSON Schema for the tool's config type (defines shape of PUT /config/{tool_name} body)."
            },
            "tool_name": {
              "type": "string",
              "description": "Tool name (bundle/local)."
            }
          }
        },
        "ToolOutcomeDto": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "value",
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "result"
                  ]
                },
                "value": {}
              }
            },
            {
              "type": "object",
              "required": [
                "value",
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "error"
                  ]
                },
                "value": {}
              }
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "status_only"
                  ]
                }
              }
            }
          ]
        },
        "UndeployRequestDto": {
          "type": "object",
          "required": [
            "hash"
          ],
          "properties": {
            "hash": {
              "type": "string"
            }
          }
        },
        "UndeployResponseDto": {
          "type": "object",
          "required": [
            "removed"
          ],
          "properties": {
            "removed": {
              "type": "boolean"
            }
          }
        }
      },
      "securitySchemes": {
        "RunnerToken": {
          "type": "apiKey",
          "in": "header",
          "name": "X-Runner-Token"
        }
      }
    },
    "tags": [
      {
        "name": "agents",
        "description": "Agent discovery, deterministic dispatch, and A2A JSON-RPC"
      },
      {
        "name": "mermaid",
        "description": "Provenance graph as Mermaid sequence diagrams (when SurrealDB provenance is enabled)"
      },
      {
        "name": "provenance",
        "description": "Provenance-backed read APIs. UI observation should use conversation-history/episode snapshot+stream routes; /provenance/messages remains analytics-oriented."
      },
      {
        "name": "deployments",
        "description": "Runner-local deployment lifecycle APIs (deploy, undeploy, list)."
      },
      {
        "name": "config",
        "description": "Tool configuration and secret requests (schema includes config type schemas)"
      },
      {
        "name": "control",
        "description": "Operational control plane: agent migration between runners."
      },
      {
        "name": "cluster",
        "description": "Cluster-wide read views (e.g. /cluster/agents) that fan out across runner replicas."
      }
    ]
  }
}
