    "components": {
      "schemas": {
        "AgentCardDto": {
          "type": "object",
          "description": "Cut-down agent card (included in every GET /agents item).",
          "required": [
            "name",
            "version",
            "agent_package",
            "agent_instance_id",
            "tools",
            "baml_functions",
            "capabilities"
          ],
          "properties": {
            "agent_instance_id": {
              "type": "string"
            },
            "agent_package": {
              "type": "string"
            },
            "baml_functions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "BAML function names registered in the agent's runtime."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "content_hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "repository_version": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            },
            "subscriptions": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgentEventSubscriptionDto"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string"
            }
          }
        },
        "AgentDeliverableMessageShape": {
          "type": "object",
          "description": "Agent-deliverable message shape: one JSON body operators can put in `messages[]`.",
          "required": [
            "message_shape_id",
            "display_name",
            "description",
            "origin",
            "payload_name",
            "wire_schema_version",
            "source_kind",
            "payload_schema",
            "samples",
            "delivery_defaults"
          ],
          "properties": {
            "delivery_defaults": {
              "$ref": "#/components/schemas/MessageShapeDeliveryDefaults"
            },
            "description": {
              "type": "string"
            },
            "display_name": {
              "type": "string"
            },
            "message_shape_id": {
              "type": "string"
            },
            "origin": {
              "type": "string",
              "description": "Required origin identity (tool path or daemon name) for traceability."
            },
            "payload_name": {
              "type": "string"
            },
            "payload_schema": {},
            "samples": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MessageShapeSample"
              }
            },
            "source_kind": {
              "type": "string",
              "description": "Default `source_kind` for delivery envelope derivation."
            },
            "ui_hints": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/MessageShapeUiHints"
                }
              ]
            },
            "wire_schema_version": {
              "type": "string",
              "description": "Wire-level schema version (`AgentDispatchRequest.message_type`)."
            }
