source: crates/baml-rt-api/tests/api_test.rs
expression: snapshot
---
{
  "status": 200,
  "body": {
    "openapi": "3.1.0",
    "info": {
      "title": "Agentium OS Runner API",
      "description": "HTTP API for the Agentium OS agent runner: agent discovery, A2A JSON-RPC forwarding, deployment lifecycle, tool configuration, and provenance-backed observability.",
      "contact": {
        "name": "Agentium OS",
        "url": "https://github.com/semiotic-agentium/agentium-os"
      },
      "license": {
        "name": "Apache-2.0"
      },
      "version": "0.1.1"
    },
    "paths": {
      "/agents": {
        "get": {
          "tags": [
            "agents"
          ],
          "summary": "List running agents (GET /agents).",
          "operationId": "list_agents",
          "responses": {
            "200": {
              "description": "List of running agents",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/AgentDiscoveryEntryDto"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/agents/{agent_package}/{agent_instance_id}/a2a": {
        "post": {
          "tags": [
            "agents"
          ],
          "summary": "Forward A2A JSON-RPC request (POST /agents/{agent_package}/{agent_instance_id}/a2a).",
          "description": "Streams **SSE** (`text/event-stream`): each event `data:` line is one JSON-RPC 2.0 response object (same objects as the historical buffered JSON array).\n\nUnauthenticated at the application layer. Cluster isolation relies on\nnetwork policy (K8s NetworkPolicy / service mesh); external client auth\nbelongs at the ingress. Control-plane endpoints are protected by `ClusterAuthLayer`.",
          "operationId": "post_a2a",
          "parameters": [
            {
              "name": "agent_package",
              "in": "path",
              "description": "Agent package identifier (e.g. manifest name)",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agent_instance_id",
              "in": "path",
              "description": "Agent instance identifier",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "SSE stream of JSON-RPC responses",
              "content": {
                "text/event-stream": {}
              }
            },
            "400": {
              "description": "Malformed request"
            },
            "404": {
              "description": "Agent not found"
            },
            "500": {
              "description": "Internal error"
            }
          }
        }
      },
      "/agents/{agent_package}/{agent_instance_id}/dispatch": {
        "post": {
          "tags": [
            "agents"
          ],
          "summary": "Deterministic host-to-agent delivery: POST /agents/{agent_package}/{agent_instance_id}/dispatch",
          "operationId": "post_dispatch",
          "parameters": [
            {
              "name": "agent_package",
              "in": "path",
              "description": "Agent package name",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "agent_instance_id",
              "in": "path",
              "description": "Agent instance ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentDispatchRequestDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Delivery accepted",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AgentDispatchAckDto"
                  }
                }
              }
            },
            "400": {
              "description": "Bad request (validation failed)"
            },
            "404": {
              "description": "Agent not found"
            }
          }
        }
      },
      "/cluster/agents": {
        "get": {
          "tags": [
            "cluster"
          ],
          "summary": "`GET /cluster/agents` — list every package known to the cluster.",
          "description": "The response is the union of each runner's local `/agents` (for reachable\nrunners) plus the `cluster_agent_placements` table (as a fallback for\nunreachable ones). `version_skew` is set per row when more than one\ndistinct `content_hash` is observed across the runners hosting that\npackage+instance.\n\nOperator-authenticated in cluster mode: aggregating cluster topology\n(runner endpoints, service-instance ids, and per-runner content hashes)\nexposes operational layout beyond what the per-runner `/agents`\ndiscovery view reveals, so the route lives behind `X-Runner-Token` next\nto the deployment-lifecycle endpoints. Returns `404` in standalone mode\n(no cluster directory).",
          "operationId": "get_cluster_agents",
          "responses": {
            "200": {
              "description": "Cluster-wide agent view with version skew",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ClusterAgentsResponseDto"
                  }
                }
              }
            },
            "401": {
              "description": "Missing or invalid runner token (cluster mode)"
            },
            "404": {
              "description": "Standalone mode — no cluster directory"
            },
            "500": {
              "description": "Cluster directory backend failed"
            }
          },
          "security": [
            {
              "RunnerToken": []
            }
          ]
        }
      },
      "/cluster/deploy": {
        "post": {
          "tags": [
            "cluster"
          ],
          "summary": "`POST /cluster/deploy` — fan out one deploy to every runner in the cluster.",
          "description": "Resolves the request hash (or name/version → hash via the local\nrepository) once, then forwards the resolved hash to every runner\nknown to the [`ClusterDirectoryService`]. The local runner is served\nfrom the in-process [`DeploymentManager`] without a loopback HTTP\nround-trip. Peer runners get a `POST /deploy` request with the local\nrunner token forwarded — the cluster shares one token, so this is\nauthenticated cluster-internal traffic.\n\nPartial failures do not roll back: `POST /deploy` is idempotent, so\nan operator retrying after a transient peer failure converges. The\nresponse carries per-runner detail; clients should inspect\n`all_succeeded` plus the `runners` array rather than relying on a\nsingle status code.",
          "operationId": "post_cluster_deploy",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeployRequestDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Per-runner deploy results (inspect all_succeeded)",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ClusterDeployResponseDto"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid request (missing hash or name+version, bad hash format)"
            },
            "401": {
              "description": "Missing or invalid runner token (cluster mode)"
            },
            "404": {
              "description": "Standalone mode — no cluster directory"
            },
            "500": {
              "description": "Cluster directory backend failed"
            }
          },
          "security": [
            {
              "RunnerToken": []
            }
          ]
        }
      },
      "/config": {
        "get": {
          "tags": [
            "config"
          ],
          "summary": "List bundles with config schema and whether each has stored config (GET /config).",
          "operationId": "list_config",
