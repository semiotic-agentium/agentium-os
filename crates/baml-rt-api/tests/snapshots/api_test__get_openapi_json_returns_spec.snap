        "ClusterAgentPlacementDto": {
          "type": "object",
          "description": "One placement of an agent on a specific runner.",
          "required": [
            "runner_id",
            "service_instance_id",
            "endpoint",
            "source"
          ],
          "properties": {
            "content_hash": {
              "type": [
                "string",
                "null"
              ],
              "description": "`None` when the runner's agent card had no content hash. Such rows\nare excluded from the `version_skew` calculation so an unknown hash\nnever collapses with another unknown one and falsely reports parity."
            },
            "endpoint": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Display name from the runner's agent card; absent when only the\nplacement table reported this entry."
            },
            "runner_id": {
              "type": "string"
            },
            "service_instance_id": {
              "type": "string"
            },
            "source": {
              "$ref": "#/components/schemas/PlacementSourceDto",
              "description": "`\"runner\"` when the data came from a successful `/agents` fan-out;\n`\"placement\"` when only the placement table knew about it."
            },
            "updated_at_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "description": "When the placement row was last written. Set only for\n`source = \"placement\"` rows so operators can judge how stale the\nfallback is. Absent for `source = \"runner\"` rows (the runner's live\nresponse makes write-time meaningless)."
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "description": "Display version from the runner's agent card; absent when only the\nplacement table reported this entry."
            }
          }
        },
        "ClusterAgentRowDto": {
          "type": "object",
          "description": "One row in the cluster-wide agent view, aggregated by package+instance.",
          "required": [
            "agent_package",
            "agent_instance_id",
            "version_skew",
            "placements"
          ],
          "properties": {
            "agent_instance_id": {
              "type": "string"
            },
            "agent_package": {
              "type": "string"
            },
            "placements": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ClusterAgentPlacementDto"
              }
            },
            "version_skew": {
              "type": "boolean",
              "description": "`true` when the placements report more than one distinct `content_hash`."
            }
          }
        },
        "ClusterAgentsResponseDto": {
          "type": "object",
          "description": "Cluster-wide agent view (`GET /cluster/agents` response body).",
          "required": [
            "runners",
            "agents"
          ],
          "properties": {
            "agents": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ClusterAgentRowDto"
              },
              "description": "One entry per `(agent_package, agent_instance_id)` observed in the\ncluster, with the per-runner placements that back it."
            },
            "runners": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ClusterRunnerStatusDto"
              },
              "description": "One entry per known runner, with reachability for this fan-out."
            }
          }
        },
        "ClusterDeployResponseDto": {
          "type": "object",
          "description": "Cluster-wide deploy result (`POST /cluster/deploy` response body).",
          "required": [
            "hash",
            "runners",
            "all_succeeded"
          ],
          "properties": {
            "all_succeeded": {
              "type": "boolean",
              "description": "`true` when every runner reports success. False when any runner\nfailed — partial deploys do not roll back successes, since\n`POST /deploy` is idempotent on subsequent attempts."
            },
            "hash": {
              "type": "string",
              "description": "Resolved content hash that was fanned out to every runner."
            },
            "runners": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ClusterDeployRunnerResultDto"
              },
              "description": "One entry per runner the deploy was attempted on."
            }
          }
        },
        "ClusterDeployRunnerResultDto": {
          "type": "object",
          "description": "Per-runner deploy outcome.",
          "required": [
            "runner_id",
            "service_instance_id",
            "endpoint",
            "ok"
          ],
          "properties": {
            "already_deployed": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "`Some(true)` when the runner reported the hash was already deployed.\n`Some(false)` when the runner accepted a fresh deploy. `None` when\nthe runner failed (see [`Self::error`])."
            },
            "endpoint": {
              "type": "string"
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "description": "Error detail when `ok` is false."
            },
            "ok": {
              "type": "boolean",
              "description": "`true` when the runner accepted (or already had) the deploy."
            },
            "runner_id": {
              "type": "string"
            },
            "service_instance_id": {
              "type": "string"
            }
          }
        },
        "ClusterRunnerStatusDto": {
          "type": "object",
          "description": "Status of a runner during this fan-out attempt.",
          "required": [
            "runner_id",
            "service_instance_id",
            "endpoint",
            "reachable"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "description": "Error detail when `reachable` is false."
            },
            "last_heartbeat_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            },
            "reachable": {
              "type": "boolean",
              "description": "`true` if this runner's `/agents` fetch succeeded."
            },
            "runner_id": {
              "type": "string"
            },
            "service_instance_id": {
              "type": "string"
            }
          }
        },
