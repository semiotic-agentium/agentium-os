                }
              }
            }
          }
        }
      },
      "/provenance/llm-calls": {
        "get": {
          "tags": [
            "provenance"
          ],
          "operationId": "get_provenance_llm_calls",
          "responses": {
            "200": {
              "description": "Provenance LLM calls query response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            }
          }
        }
      },
      "/provenance/messages": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Message analytics query (not transcript reconstruction)",
          "description": "Analytics-only message aggregates/dimensions. For UI chat/provenance observation, use GET /contexts/{context_id}/conversation-history and /contexts/{context_id}/conversation-history/stream.",
          "operationId": "get_provenance_messages",
          "responses": {
            "200": {
              "description": "Provenance message query response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            }
          }
        }
      },
      "/provenance/tool-calls": {
        "get": {
          "tags": [
            "provenance"
          ],
          "operationId": "get_provenance_tool_calls",
          "responses": {
            "200": {
              "description": "Provenance tool calls query response",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            }
          }
        }
      },
      "/tasks/{task_id}/episode": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Episode snapshot by task_id",
          "operationId": "get_episode",
          "parameters": [
            {
              "name": "task_id",
              "in": "path",
              "description": "A2A task ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Episode snapshot",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/EpisodeSnapshotDto"
                  }
                }
              }
            },
            "404": {
              "description": "No episode found for task"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Episode service not available"
            }
          }
        }
      },
      "/tasks/{task_id}/episode/stream": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Streaming episode updates by task_id",
          "operationId": "get_episode_stream",
          "parameters": [
            {
              "name": "task_id",
              "in": "path",
              "description": "A2A task ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "SSE stream of episode snapshots",
              "content": {
                "text/event-stream": {}
              }
            },
            "404": {
              "description": "No episode found for task"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Episode service not available"
            }
          }
        }
      },
      "/tasks/{task_id}/episode/text": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Episode as canonical plain text",
          "operationId": "get_episode_text",
          "parameters": [
            {
              "name": "task_id",
              "in": "path",
              "description": "A2A task ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Episode plain text",
              "content": {
                "text/plain": {}
              }
            },
            "404": {
              "description": "No episode found for task"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Episode service not available"
            }
          }
        }
      },
      "/tasks/{task_id}/mermaid": {
        "get": {
          "tags": [
            "mermaid"
          ],
          "summary": "Mermaid diagram by task",
          "description": "Returns the provenance subgraph for the given A2A task ID as a Mermaid sequenceDiagram (text/plain). Available when the runner is started with SurrealDB provenance.",
          "operationId": "get_mermaid_task",
          "parameters": [
            {
              "name": "task_id",
              "in": "path",
              "description": "A2A task ID",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Mermaid sequenceDiagram",
              "content": {
                "text/plain": {}
              }
            },
            "404": {
              "description": "No graph found for task"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Mermaid service not available (provenance not configured)"
            }
          }
        }
      },
      "/undeploy": {
        "post": {
          "tags": [
            "deployments"
          ],
          "summary": "Undeploy an active deployment by content hash.",
          "operationId": "post_undeploy",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UndeployRequestDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Undeploy accepted",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/UndeployResponseDto"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid undeploy payload"
            },
            "401": {
              "description": "Missing or invalid runner token"
            },
            "404": {
              "description": "Deployment not found"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Deployment manager not configured"
            }
          },
          "security": [
            {
              "RunnerToken": []
            }
          ]
        }
      }
    },
    "components": {
      "schemas": {
        "AgentCardDto": {
          "type": "object",
          "description": "Cut-down agent card (included in every GET /agents item).",
          "required": [
            "name",
            "version",
            "agent_package",
            "agent_instance_id",
            "tools",
            "baml_functions",
            "capabilities"
          ],
          "properties": {
            "agent_instance_id": {
              "type": "string"
            },
            "agent_package": {
              "type": "string"
            },
            "baml_functions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "BAML function names registered in the agent's runtime."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "content_hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "repository_version": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            },
            "subscriptions": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgentEventSubscriptionDto"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string"
            }
          }
        },
        "AgentDiscoveryEntryDto": {
          "type": "object",
          "description": "Discovery entry for one running agent (GET /agents response item).",
          "required": [
            "agent_package",
            "agent_instance_id",
            "name",
            "version",
            "agent_card"
          ],
          "properties": {
            "agent_card": {
              "$ref": "#/components/schemas/AgentCardDto",
              "description": "Agent card (cut-down shape) for discovery."
            },
            "agent_instance_id": {
              "type": "string"
            },
            "agent_package": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "AgentDispatchAckDto": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "AgentDispatchRequestDto": {
          "type": "object",
          "required": [
            "routing_key",
            "message_type"
          ],
          "properties": {
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_type": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metadata": {
              "type": "object"
            },
            "routing_key": {
              "type": "string"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "AgentEventSubscriptionDto": {
          "type": "object",
          "required": [
            "schema_versions",
            "source_kinds",
            "source_keys",
            "source_key_prefixes"
          ],
          "properties": {
            "schema_versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_key_prefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_kinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ArtifactSummaryDto": {
          "type": "object",
          "description": "Artifact summary for UI display.",
          "required": [
            "name"
          ],
          "properties": {
            "media_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        "ConfigVersionDto": {
          "type": "object",
          "description": "Config at a specific version.",
          "required": [
            "version",
            "config",
            "created_at_ms"
          ],
          "properties": {
            "config": {
              "type": "object",
              "description": "Config snapshot. Shape defined by tool's config schema."
            },
            "created_at_ms": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "version": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ContextMetricsResponseDto": {
          "type": "object",
          "description": "API response for `GET /contexts/{context_id}/metrics`.",
          "required": [
            "context_id",
            "turns",
            "session"
          ],
          "properties": {
            "context_id": {
              "type": "string"
            },
            "session": {
              "$ref": "#/components/schemas/ContextSessionMetricsDto"
            },
            "turns": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ContextTurnMetricsDto"
              }
            }
          }
        },
        "ContextPickerItemDto": {
          "type": "object",
          "required": [
            "contextId",
            "latestTimestampMs",
            "preview"
          ],
          "properties": {
            "contextId": {
              "type": "string"
            },
            "latestTimestampMs": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "preview": {
              "type": "string"
            }
          }
        },
        "ContextPickerPageDto": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ContextPickerItemDto"
              }
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ContextSessionMetricsDto": {
          "type": "object",
          "description": "Session-level aggregate metrics for one context id.",
          "required": [
            "turns_total",
            "user_prompts_total",
            "llm_calls_total",
            "llm_duration_ms_total",
            "prompt_context_bytes_current",
            "tokens_total"
          ],
          "properties": {
            "llm_calls_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "llm_duration_ms_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "prompt_context_bytes_current": {
              "type": "integer",
              "format": "int64",
              "description": "Serialized prompt JSON bytes for the **latest** LLM call in this context (temporal tail).",
              "minimum": 0
            },
            "tokens_total": {
              "$ref": "#/components/schemas/TokenUsageDto"
            },
            "turns_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "user_prompts_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ContextTurnMetricsDto": {
          "type": "object",
          "description": "Turn-level metrics scoped by `(context_id, message_id)`.",
          "required": [
            "message_id",
            "user_prompt_count",
            "llm_call_count",
            "llm_duration_ms_total",
            "prompt_context_bytes_current",
            "tokens"
          ],
          "properties": {
            "llm_call_count": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "llm_duration_ms_total": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "message_id": {
              "type": "string"
            },
            "prompt_context_bytes_current": {
              "type": "integer",
              "format": "int64",
              "description": "Serialized prompt JSON bytes for the **latest** LLM call in this turn (`a2a_event_order` tail).",
              "minimum": 0
            },
            "tokens": {
              "$ref": "#/components/schemas/TokenUsageDto"
            },
            "user_prompt_count": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ConversationHistoryContentDto": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text",
                "type"
              ],
              "properties": {
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "text": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "message"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "tool_name",
                "args",
                "fsm_phase",
                "type"
              ],
              "properties": {
                "args": {},
                "fsm_phase": {
                  "type": "string"
                },
                "tool_name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "tool_call"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "tool_name",
                "fsm_phase",
                "outcome",
                "type"
              ],
              "properties": {
                "fsm_phase": {
                  "type": "string"
                },
                "outcome": {
                  "$ref": "#/components/schemas/ToolOutcomeDto"
                },
                "tool_name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "tool_result"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "tool_name",
                "op",
                "type"
              ],
              "properties": {
                "op": {
                  "$ref": "#/components/schemas/SessionStepOpDto"
                },
                "read_replay_lines": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "send_done_replay_payload": {},
                "tool_name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "session_step"
                  ]
                }
              }
            }
          ]
        },
        "ConversationHistoryItemDto": {
          "type": "object",
          "required": [
            "timestampMs",
            "activityAnchor",
            "role",
            "content"
          ],
          "properties": {
            "activityAnchor": {
              "type": "string"
            },
            "content": {
              "$ref": "#/components/schemas/ConversationHistoryContentDto"
            },
            "role": {
              "type": "string"
            },
            "timestampMs": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "ConversationHistoryPageDto": {
          "type": "object",
          "required": [
            "contextId",
            "version",
            "maxEventOrder",
            "items"
          ],
          "properties": {
            "awaitingInput": {
              "type": "boolean",
              "description": "True when `a2a_task.status_json` for the effective task is `TASK_STATE_INPUT_REQUIRED`."
            },
            "contextId": {
              "type": "string"
            },
            "inputRequiredPrompt": {
              "type": [
                "string",
                "null"
              ],
              "description": "First text part from the status message when [Self::awaiting_input] is true."
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ConversationHistoryItemDto"
              }
            },
            "llmPromptOperations": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LlmPromptOperationDto"
              },
              "description": "LLM prompt operations through `max_event_order` (delta may contain only new rows)."
            },
            "maxEventOrder": "[a2a_event_order]",
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "promptContextBytesSessionCurrent": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "description": "Latest LLM prompt JSON size in this scope (temporal tail).",
              "minimum": 0
            },
            "taskId": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": "string"
            }
          }
        },
        "DeployRequestDto": {
          "type": "object",
          "properties": {
            "hash": {
              "type": [
                "string",
                "null"
              ],
              "description": "Content hash to deploy directly."
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Agent name for name/version resolution."
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "description": "Agent version for name/version resolution."
            }
          }
        },
        "DeployResponseDto": {
          "type": "object",
          "required": [
            "hash",
            "already_deployed"
          ],
          "properties": {
            "already_deployed": {
              "type": "boolean"
            },
            "hash": {
