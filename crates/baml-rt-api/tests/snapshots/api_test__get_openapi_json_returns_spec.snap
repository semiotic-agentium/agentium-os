            {
              "name": "limit",
              "in": "query",
              "description": "Page size in range [1, 500], default 100",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            },
            {
              "name": "cursor",
              "in": "query",
              "description": "Opaque pagination cursor",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "profile",
              "in": "query",
              "description": "Payload profile: full or compact",
              "required": false,
              "schema": {
                "type": "string"
              }
