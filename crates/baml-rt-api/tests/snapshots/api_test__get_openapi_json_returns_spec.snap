            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Metrics service not available (provenance not configured)"
            }
          }
        }
      },
      "/contexts/{context_id}/planning": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Get context-scoped planning state (intent/plan/step progress) from provenance.",
          "operationId": "get_context_planning",
          "parameters": [
            {
              "name": "context_id",
              "in": "path",
              "description": "A2A context id",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Context planning snapshot (`tasks` empty when no provenance messages exist for this context)",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            },
            "404": {
              "description": "No planning data found for context"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Planning service unavailable"
            }
          }
        }
      },
      "/control/migrate": {
        "post": {
          "tags": [
            "control"
          ],
          "summary": "Migrate an agent from this runner to a target runner.",
          "description": "Drains the agent locally (waits for in-flight turns), then tells the target\nrunner to deploy the same content hash.",
          "operationId": "post_migrate",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MigrateRequestDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Agent migrated successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/MigrateResponseDto"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid request"
            },
            "401": {
              "description": "Missing or invalid runner token"
            },
            "404": {
              "description": "Agent not found locally"
            },
            "501": {
              "description": "Deployment manager not configured"
            },
            "502": {
              "description": "Target runner unreachable"
            }
          },
          "security": [
            {
              "RunnerToken": []
            }
          ]
        }
      },
      "/deploy": {
        "post": {
          "tags": [
            "deployments"
          ],
          "summary": "Deploy an agent by content hash or name/version.",
          "operationId": "post_deploy",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeployRequestDto"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Deployment accepted",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/DeployResponseDto"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid deploy payload"
            },
            "401": {
              "description": "Missing or invalid runner token"
            },
            "404": {
              "description": "Hash or version target not found"
            },
            "409": {
              "description": "Deployment conflict"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Deployment manager not configured"
            }
          },
          "security": [
            {
              "RunnerToken": []
            }
          ]
        }
      },
      "/deployments": {
        "get": {
          "tags": [
            "deployments"
          ],
          "summary": "List runner-local deployment records.",
          "operationId": "get_deployments",
          "responses": {
            "200": {
              "description": "Deployment records",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DeploymentRecordDto"
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Missing or invalid runner token"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Deployment manager not configured"
            }
          },
          "security": [
            {
              "RunnerToken": []
            }
          ]
        }
      },
      "/provenance/aggregates": {
        "get": {
          "tags": [
