        "ProvisionSecretDto": {
          "type": "object",
          "description": "Request body for linking a secret by name (PUT /config/secrets/{name}).\nOnly link_from is accepted; secrets are stored in the secret store (fnox), never sent as raw values.",
          "required": [
            "link_from"
          ],
          "properties": {
            "link_from": {
              "type": "string",
              "description": "Key name in the secret store (fnox/env) to link from. The runner resolves this and uses its value for {name}."
            }
          }
        },
        "SecretOverviewEntryDto": {
          "type": "object",
          "description": "One secret in the M:N overview: which tools and LLM clients require it.",
          "required": [
            "name",
            "tool_consumers",
            "llm_consumers",
            "satisfied"
          ],
          "properties": {
            "descriptor": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the secret must provide (from first tool that declares it)."
            },
            "justification": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why this secret is needed (from first tool that declares it)."
            },
            "linked_to": {
              "type": [
                "string",
                "null"
              ],
              "description": "When satisfied and linked via the UI: the key in the secret store this secret is linked to (e.g. env.OPENROUTER_API_KEY). Omitted when not linked or loaded from defaults only."
            },
            "llm_consumers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "LLM client names that reference this secret (e.g. api_key placeholder for OPENROUTER_API_KEY)."
            },
            "name": {
              "type": "string",
              "description": "Canonical secret name / key (e.g. NOTION_API_TOKEN)."
            },
            "satisfied": {
              "type": "boolean",
              "description": "True if the secret is provisioned (resolver returns a value for this key); false when missing or when resolver is unavailable. Always present (not optional)."
            },
            "secret_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Type from tool secret_requests (e.g. \"api_key\"); absent if only referenced by LLM."
            },
            "tool_consumers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tool names (bundle/local) that declare this secret."
            }
          }
        },
        "SecretRequestDto": {
          "type": "object",
          "description": "Secret request (for GET /config/{tool_name}/secret-requests).",
          "required": [
            "name",
            "secret_type",
            "justification",
            "descriptor"
          ],
          "properties": {
            "descriptor": {
              "type": "string"
            },
