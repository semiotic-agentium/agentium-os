      "/contexts": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Context picker index",
          "description": "Typed context index for chat history selection. This is the product workflow source for context-scoped restore.",
          "operationId": "get_context_index",
          "parameters": [
            {
              "name": "agentPackage",
              "in": "query",
              "description": "Optional agent package filter",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "limit",
              "in": "query",
              "description": "Page size in range [1, 200], default 50",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            },
            {
              "name": "cursor",
              "in": "query",
              "description": "Opaque pagination cursor",
              "required": false,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Context picker page",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ContextPickerPageDto"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid query/cursor"
            },
            "500": {
              "description": "Internal error"
            },
            "501": {
              "description": "Context index service not configured"
            }
          }
        }
      },
      "/contexts/{context_id}/conversation-history": {
        "get": {
          "tags": [
            "provenance"
          ],
          "summary": "Conversation history page by context_id",
