  ChooseCalculatoragentTool__continue__support_calculate: { args: Parameters<typeof ChooseCalculatoragentTool__continue__support_calculate>[0] & StepExecutorStateInput; result: Awaited<ReturnType<typeof ChooseCalculatoragentTool__continue__support_calculate>>; };
