  Update
    @alias("update")
}

class NestedRequest {
  address Address
  kind RequestKind
  @@dynamic
}

class RepresentativeToolInput {
  request NestedRequest
  required_nullable string | null
  optional_note string?
  labels map<string, string>
  addresses Address[]
  content (RepresentativeToolInputContent | RepresentativeToolInputContent[])?
