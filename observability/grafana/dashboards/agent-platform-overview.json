{
  "annotations": {"list": []},
  "description": "Agent Platform overview. Template variables filter the agent-scoped panels; defaults are All. See observability/README.md (pilot observability contract) and docs/reference/otel-trace-instrumentation-guide.md (cross-runner A2A forwarding) for label semantics and TraceQL recipes.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "Open Tempo Explore (TraceQL recipes in docs/reference/otel-trace-instrumentation-guide.md)",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22Tempo%22%7D",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Cluster & Ingress",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingress HTTP Rate by Agent Route",
      "description": "Public /agents/... request rate. forwarded=true means a peer runner forwarded this request (advisory, spoofable on public ingress).",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 101,
      "targets": [
        {
          "expr": "sum by (route, result, forwarded) (rate(baml_rt_api_http_request_total{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{result}} fwd={{forwarded}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingress HTTP Latency (avg ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 102,
      "targets": [
        {
          "expr": "sum by (route, forwarded) (rate(baml_rt_api_http_request_duration_ms_sum{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval])) / sum by (route, forwarded) (rate(baml_rt_api_http_request_duration_ms_count{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{route}} fwd={{forwarded}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Serving A2A Rate by Agent + Runner",
      "description": "A2A handler completions from the serving runner's point of view.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 103,
      "targets": [
        {
          "expr": "sum by (method, result, serving_service_instance_id) (rate(baml_rt_a2a_request_total{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{result}} serving={{serving_service_instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "A2A Errors by Type",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "id": 104,
      "targets": [
        {
          "expr": "sum by (method, error_type, serving_service_instance_id) (rate(baml_rt_a2a_error_total{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{error_type}} serving={{serving_service_instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Forwarded vs Local Ingress Split",
      "description": "Split by `forwarded` label. forwarded is derived from the W3C baggage key ingress_service_instance_id on public /agents/... — advisory, not an auth boundary.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "id": 105,
      "targets": [
        {
          "expr": "sum by (forwarded, ingress_service_instance_id) (rate(baml_rt_api_http_request_total{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "fwd={{forwarded}} ingress={{ingress_service_instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster A2A Forward Rate",
      "description": "Ingress runner forwarding to a peer. target=unknown means the cluster resolver fallback fired.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "id": 106,
      "targets": [
        {
          "expr": "sum by (result, ingress_service_instance_id, target_service_instance_id) (rate(baml_rt_cluster_a2a_forward_total{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{result}} {{ingress_service_instance_id}}->{{target_service_instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster A2A Forward Duration (avg ms)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
      "id": 107,
      "targets": [
        {
          "expr": "sum by (result, ingress_service_instance_id, target_service_instance_id) (rate(baml_rt_cluster_a2a_forward_duration_ms_sum{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval])) / sum by (result, ingress_service_instance_id, target_service_instance_id) (rate(baml_rt_cluster_a2a_forward_duration_ms_count{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{result}} {{ingress_service_instance_id}}->{{target_service_instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "A2A Request Latency (avg ms)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "id": 108,
      "targets": [
        {
          "expr": "sum by (method, result, serving_service_instance_id) (rate(baml_rt_a2a_request_duration_ms_sum{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval])) / sum by (method, result, serving_service_instance_id) (rate(baml_rt_a2a_request_duration_ms_count{agent_package=~\"$agent_package\", agent_instance_id=~\"$agent_instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{result}} serving={{serving_service_instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Calls / sec by Function",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "targets": [
        {
          "expr": "sum by (function, result) (rate(baml_rt_llm_call_total[$__rate_interval]))",
          "legendFormat": "{{function}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Duration (avg ms) by Function",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 41},
      "targets": [
        {
          "expr": "sum by (function) (rate(baml_rt_llm_call_duration_ms_sum[$__rate_interval])) / sum by (function) (rate(baml_rt_llm_call_duration_ms_count[$__rate_interval]))",
          "legendFormat": "{{function}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Prompt Payload (avg bytes) by Function",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 41},
      "targets": [
        {
          "expr": "sum by (function) (rate(baml_rt_llm_prompt_bytes_sum[$__rate_interval])) / sum by (function) (rate(baml_rt_llm_prompt_bytes_count[$__rate_interval]))",
          "legendFormat": "{{function}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Tokens In / sec by Function",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
      "targets": [
        {
          "expr": "sum by (function) (rate(baml_rt_llm_tokens_in_total[$__rate_interval]))",
          "legendFormat": "{{function}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Tokens Out / sec by Function",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
      "targets": [
        {
          "expr": "sum by (function) (rate(baml_rt_llm_tokens_out_total[$__rate_interval]))",
          "legendFormat": "{{function}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool Invocation Duration (avg ms) by Tool",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 57},
      "targets": [
        {
          "expr": "sum by (tool, result) (rate(baml_rt_tool_invocation_duration_ms_sum[$__rate_interval])) / sum by (tool, result) (rate(baml_rt_tool_invocation_duration_ms_count[$__rate_interval]))",
          "legendFormat": "{{tool}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool Calls / sec by Tool",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 57},
      "targets": [
        {
          "expr": "sum by (tool, result) (rate(baml_rt_tool_invocation_total[$__rate_interval]))",
          "legendFormat": "{{tool}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ONNX Inference Wait (avg ms) by Operation",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 65},
      "targets": [
        {
          "expr": "sum by (operation) (rate(baml_rt_onnx_wait_ms_sum[$__rate_interval])) / sum by (operation) (rate(baml_rt_onnx_wait_ms_count[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ONNX Inference Run (avg ms) by Operation",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 65},
      "targets": [
        {
          "expr": "sum by (operation) (rate(baml_rt_onnx_run_ms_sum[$__rate_interval])) / sum by (operation) (rate(baml_rt_onnx_run_ms_count[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ONNX Wait/Run Ratio (avg) by Operation",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 73},
      "targets": [
        {
          "expr": "sum by (operation) (rate(baml_rt_onnx_wait_to_run_ratio_sum[$__rate_interval])) / sum by (operation) (rate(baml_rt_onnx_wait_to_run_ratio_count[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ONNX Wait-Dominant Events / sec by Operation",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 73},
      "targets": [
        {
          "expr": "sum by (operation) (rate(baml_rt_onnx_wait_dominant_total[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["agent-platform", "otel"],
  "templating": {
    "list": [
      {
        "name": "agent_package",
        "label": "Agent package",
        "description": "Filter agent-scoped panels by agent_package. Defaults to All. Populated from baml_rt_a2a_request_total.",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "query": "label_values(baml_rt_a2a_request_total, agent_package)",
        "refresh": 2,
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"text": "All", "value": "$__all", "selected": true},
        "sort": 1,
        "options": []
      },
      {
        "name": "agent_instance_id",
        "label": "Agent instance",
        "description": "Filter agent-scoped panels by agent_instance_id. Defaults to All.",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "query": "label_values(baml_rt_a2a_request_total{agent_package=~\"$agent_package\"}, agent_instance_id)",
        "refresh": 2,
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"text": "All", "value": "$__all", "selected": true},
        "sort": 1,
        "options": []
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
