/target

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Example agent dependencies
examples/agent-example/node_modules/
examples/agent-example/package-lock.json

# Build artifacts
*.tar.gz
!examples/agent-packages/*.tar.gz

# ts-rs generated TypeScript bindings
bindings/

# Generated BAML TypeScript client (not used by our runtime, but may be generated by users)
baml_client/

# Compiled JavaScript output (in agent directories)
dist/

# Environment files (API keys, etc.)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Provenance and config databases (SurrealKV directories)
provenance.db
provenance.db-shm
provenance.db-wal
config.db
crates/baml-agent-runner/.repository/
crates/baml-agent-runner/.runner-state/

# Local runtime state and debug artifacts (do not commit)
/.repository/
/.runner-state/
/provenance_db
/provenance_db-shm
/provenance_db-wal

# Fastembed model cache (downloaded ONNX models, ~130 MB)
.fastembed_cache/

# Nix
.direnv/
result
