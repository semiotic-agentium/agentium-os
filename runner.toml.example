# Example runner.toml — copy to runner.toml and adjust paths.
#
# Pass to the runner via `--runner-config ./runner.toml`
# (or set BAML_RUNNER_CONFIG=./runner.toml).
#
# Relative paths are resolved against this file's parent directory.
# BAML_EXTERNAL_TOOLS_DIR (colon-separated) overrides `[external_tools].dirs`
# when set and non-empty.
#
# External tools themselves are not configured here: publish them with
# `karak tool publish` and list them in the agent manifest.

[external_tools]
# Webhook datasource manifest dirs. Each holds a tool-manifest.json that
# declares `datasources[]` and the `events[]` they emit; no process runs.
dirs = [
    # "./examples/external-tools/deploy-health-datasource",
]

# Activation, keyed by "<tool name>"."<datasource key>". A datasource is only
# mounted (POST /webhooks/ext/<tool name>/<key>) when it is listed here.
# [external_datasources."examples/deploy-health-datasource"."events"]
# source_key = "deploy-health:prod"
